$("homeBtn").onclick=home;$("back").onclick=home;
$("learnerBtn").onclick=changeLearner;$("skipLesson").onclick=skipLesson;
updateLearnerBtn();
document.addEventListener("visibilitychange",()=>{
 if(document.hidden)flushWatchTime();
 else if(player?.getPlayerState&&window.YT&&player.getPlayerState()===YT.PlayerState.PLAYING)watchTimerStart=Date.now();
});
window.addEventListener("beforeunload",flushWatchTime);
let adminUnlocked=false;
const ADMIN_PASSWORD_KEY="videoLessonAdminPassword_v1";
const DEFAULT_ADMIN_PASSWORD="admin1234";

function getAdminPassword(){
  return localStorage.getItem(ADMIN_PASSWORD_KEY) || DEFAULT_ADMIN_PASSWORD;
}
function requestAdmin(){
  flushWatchTime();
  if(adminUnlocked){openAdmin();return}
  $("adminPasswordInput").value="";
  $("passwordError").textContent="";
  $("passwordModal").classList.add("show");
  setTimeout(()=>$("adminPasswordInput").focus(),50);
}
function submitAdminPassword(){
  if($("adminPasswordInput").value===getAdminPassword()){
    adminUnlocked=true;
    $("passwordModal").classList.remove("show");
    openAdmin();
  }else{
    $("passwordError").textContent="パスワードが正しくありません。";
    $("adminPasswordInput").select();
  }
}
$("adminBtn").onclick=requestAdmin;
$("passwordSubmit").onclick=submitAdminPassword;
$("passwordCancel").onclick=()=>$("passwordModal").classList.remove("show");
$("adminPasswordInput").addEventListener("keydown",e=>{if(e.key==="Enter")submitAdminPassword()});
$("adminBack").onclick=home;
$("editTab").onclick=renderEditor;$("logTab").onclick=renderLogs;
$("restart").onclick=()=>{
 flushWatchTime();
 let p=load(PROGRESS_KEY,{});p[learner]??={};p[learner][course.id]={done:[],skipped:[],watch:{}};put(PROGRESS_KEY,p);
 addLog("受講リセット",course.title,"");lessonIndex=0;loadLesson(0)
};
window.onYouTubeIframeAPIReady=()=>{if(pendingId){createPlayer(pendingId);pendingId=null}};
let s=document.createElement("script");s.src="https://www.youtube.com/iframe_api";document.head.appendChild(s);
renderCourses();
